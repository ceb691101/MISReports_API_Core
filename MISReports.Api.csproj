
<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- MIS Reports API on .NET 9 -->
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <RootNamespace>MISReports_Api</RootNamespace>
    <AssemblyName>MISReports.Api</AssemblyName>

    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <!-- Informix driver selection -->
  <PropertyGroup>
    <InformixDriver Condition="'$(InformixDriver)' == '' and $([MSBuild]::IsOSPlatform('Windows'))">OleDb</InformixDriver>
    <InformixDriver Condition="'$(InformixDriver)' == ''">Db2</InformixDriver>
  </PropertyGroup>

  <!-- Windows OleDb driver -->
  <PropertyGroup Condition="'$(InformixDriver)' == 'OleDb'">
    <RuntimeIdentifier>win-x86</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <DefineConstants>$(DefineConstants);INFORMIX_OLEDB</DefineConstants>
  </PropertyGroup>

  <!-- NuGet dependencies -->
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="9.0.23" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="NLog" Version="6.0.3" />
    <PackageReference Include="NLog.Extensions.Logging" Version="6.0.3" />
    <PackageReference Include="Oracle.ManagedDataAccess.Core" Version="23.26.200" />
    <PackageReference Include="EPPlus" Version="8.0.6" />

    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
  </ItemGroup>

  <!-- Informix DB2 driver -->
  <ItemGroup Condition="'$(InformixDriver)' == 'Db2'">

    <!-- Linux x64 -->
    <PackageReference
      Include="Net.IBM.Data.Db2-lnx"
      Version="9.0.0.400"
      Condition="'$(RuntimeIdentifier)' == 'linux-x64'" />

    <!-- Windows development -->
    <PackageReference
      Include="Net.IBM.Data.Db2"
      Version="9.0.0.400"
      Condition="'$(RuntimeIdentifier)' == 'win-x86' Or '$(RuntimeIdentifier)' == 'win-x64' Or ($([MSBuild]::IsOSPlatform('Windows')) And '$(RuntimeIdentifier)' == '')" />

  </ItemGroup>

  <!-- OleDb package -->
  <ItemGroup Condition="'$(InformixDriver)' == 'OleDb'">
    <PackageReference Include="System.Data.OleDb" Version="10.0.0" />
  </ItemGroup>

  <!-- Configuration and content files -->
  <ItemGroup>
    <None Update="NLog.config"
          CopyToOutputDirectory="PreserveNewest" />

    <Content Update="secrets\**"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="Never" />
  </ItemGroup>

</Project>
