<Project Sdk="Microsoft.NET.Sdk.Web">
  <!-- MIS Reports API on .NET 10 (migrated from ASP.NET Web API 2). See docs/MIGRATION.md. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>MISReports_Api</RootNamespace>
    <AssemblyName>MISReports.Api</AssemblyName>
    <!-- The migrated code was written without nullable annotations or implicit usings. -->
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <!--
    Informix driver:
      OleDb = the existing 32-bit Ifxoledbc driver (Windows only). Default on Windows, so
              "dotnet run" works on the same machines as the old API.
      Db2   = IBM's DRDA driver (Linux and Windows). Default elsewhere and in Docker.
    Override with: dotnet build -p:InformixDriver=Db2
  -->
  <PropertyGroup>
    <InformixDriver Condition="'$(InformixDriver)' == '' and $([MSBuild]::IsOSPlatform('Windows'))">OleDb</InformixDriver>
    <InformixDriver Condition="'$(InformixDriver)' == ''">Db2</InformixDriver>
  </PropertyGroup>
  <PropertyGroup Condition="'$(InformixDriver)' == 'OleDb'">
    <!-- Ifxoledbc is 32-bit only: run as a 32-bit, self-contained app (no extra runtime install needed). -->
    <RuntimeIdentifier>win-x86</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <DefineConstants>$(DefineConstants);INFORMIX_OLEDB</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.13" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="NLog" Version="6.0.3" />
    <PackageReference Include="NLog.Extensions.Logging" Version="6.0.3" />
    <PackageReference Include="Oracle.ManagedDataAccess.Core" Version="23.26.200" />
    <PackageReference Include="EPPlus" Version="8.0.6" />
    <!-- Security: the Oracle driver pulls in an older version with known vulnerabilities
         (GHSA-846f-f764-76mx high, GHSA-2fmv-rv2c-59x7 moderate). Pin the patched release. -->
    <PackageReference Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
  </ItemGroup>

  <ItemGroup Condition="'$(InformixDriver)' == 'Db2'">
    <PackageReference Include="Net.IBM.Data.Db2-lnx" Version="10.0.0.100" Condition="$([MSBuild]::IsOSPlatform('Linux'))" />
    <PackageReference Include="Net.IBM.Data.Db2" Version="10.0.0.100" Condition="$([MSBuild]::IsOSPlatform('Windows'))" />
  </ItemGroup>
  <ItemGroup Condition="'$(InformixDriver)' == 'OleDb'">
    <PackageReference Include="System.Data.OleDb" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <None Update="NLog.config" CopyToOutputDirectory="PreserveNewest" />
    <!-- Real secrets are copied next to the app for local runs, but never into a publish/Docker image. -->
    <Content Update="secrets\**" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="Never" />
  </ItemGroup>
</Project>
